{
  "name": "caryn-ops-tracker",
  "version": "0.1.0",
  "private": true,
  "description": "Master project tracker: ingests transcripts, .msg attachments, and a Confluence page directory, then syncs daily synthesis blocks to the right Confluence pages.",
  "type": "module",
  "bin": {
    "tracker": "./dist/cli.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "verify": "tsx src/cli.ts verify",
    "index": "tsx src/cli.ts index",
    "ingest": "tsx src/cli.ts ingest",
    "sync": "tsx src/cli.ts sync",
    "loop": "tsx src/cli.ts loop",
    "test": "node --test --import tsx --test-reporter=spec test/**/*.test.ts"
  },
  "dependencies": {
    "fuse.js": "^7.0.0",
    "mammoth": "^1.8.0",
    "@kenjiuno/msgreader": "^1.28.0",
    "undici": "^6.21.0",
    "yargs": "^17.7.2",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/yargs": "^17.0.33",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  },
  "engines": {
    "node": ">=20"
  }
}
